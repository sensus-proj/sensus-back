  "MediaDelivery": {
    "SigningKey": "",
    "PublicBaseUrl": "https://localhost:5001",
    "PublicTtlMinutes": 60,
    "PrivateTtlMinutes": 5,
    "PublicCacheSeconds": 86400
  },
  "AiBudgetStore": {
    "TableName": "",
    "ServiceUrl": "",
    "TimeoutSeconds": 3
  },
  "OpenAiSettings": {
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "BaseUrl": "https://api.openai.com/v1",
    "TimeoutSeconds": 8,
    "Moderation": {
      "MaxRetries": 1,
      "RetryDelayMilliseconds": 500
    },
    "Sensi": {
      "ModerationModel": "omni-moderation-latest",
      "FastModel": "gpt-4o-mini",
      "ReasoningModel": "gpt-4o",
      "TotalBudgetCapUsd": 5.0,
      "ReasoningBudgetCapUsd": 3.0,
      "AlertThresholdRatio": 0.80,
      "MaxInputChars": 1500,
      "MaxCompletionTokens": 500,
      "Temperature": 0.0,
      "MaxTurnsHistory": 6,
      "MaxCitedOfferCards": 5,
      "DailyMessageLimitPerUser": 20,
      "MaxAgenticRounds": 3,
      "TimeoutSeconds": 25,
      "FastEstimatedCostUsd": 0.001,
      "ReasoningEstimatedCostUsd": 0.016,
      "TraceRetentionDays": 30,
      "TextModerationThresholds": {
        "hate": { "Low": 0.30, "High": 0.70 },
        "hate/threatening": { "Low": 0.20, "High": 0.60 },
        "harassment": { "Low": 0.35, "High": 0.75 },
        "harassment/threatening": { "Low": 0.20, "High": 0.60 },
        "self-harm": { "Low": 0.20, "High": 0.60 },
        "sexual": { "Low": 0.20, "High": 0.70 },
        "sexual/minors": { "Low": 0.05, "High": 0.20 },
        "violence": { "Low": 0.40, "High": 0.80 },
        "violence/graphic": { "Low": 0.25, "High": 0.70 }
      }
    },
    "DefaultLowThreshold": 0.35,
    "DefaultHighThreshold": 0.75,
    "CategoryThresholds": {
      "weapons": { "Low": 0.20, "High": 0.60 },
      "sexual": { "Low": 0.20, "High": 0.70 },
      "sexual/minors": { "Low": 0.05, "High": 0.20 },
      "hate": { "Low": 0.30, "High": 0.70 },
      "hate/threatening": { "Low": 0.20, "High": 0.60 },
      "harassment": { "Low": 0.35, "High": 0.75 },
      "harassment/threatening": { "Low": 0.20, "High": 0.60 },
      "self-harm": { "Low": 0.20, "High": 0.60 },
      "self-harm/intent": { "Low": 0.15, "High": 0.50 },
      "self-harm/instructions": { "Low": 0.10, "High": 0.40 },
      "violence": { "Low": 0.40, "High": 0.80 },
      "violence/graphic": { "Low": 0.25, "High": 0.70 },
      "illicit": { "Low": 0.30, "High": 0.70 },
      "illicit/violent": { "Low": 0.20, "High": 0.60 }
    }
  },
  "Cache": {
    "Memory": {
      "Enabled": true,
      "MaxEntries": 1000,
      "MaxTtlSeconds": 60
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "Enabled": true,
    "DefaultTtlMinutes": 30,
    "TtlByEntityMinutes": {
      "UserProfile": 15,
      "MyComercio": 30,
      "Offers": 10,
      "Feed": 5,
      "AiFaq": 60
    }
  },
  "AccountDeletion": {
    "RetentionDays": 30,
    "PurgeIntervalHours": 24,
    "ModerationAuditRetentionDays": 90
  },
  "Moderation": {
    "QuarantineRetentionDays": 30,
    "OfferRetry": {
      "MaxAttempts": 5,
      "RetryDelaySeconds": 60,
      "CheckIntervalSeconds": 60,
      "BatchSize": 20
    },
    "Audit": {
      "RetentionDays": 2555
    },
    "Sanctions": {
      "Enabled": true,
      "TriggerDecision": "Rejected",
      "EscalationWindowDays": 90,
      "Steps": [
        { "Hours": 24 },
        { "Hours": 168 },
        { "Hours": 720 },
        { "Permanent": true }
      ]
    }
  },
  "NearbyOfferAlerts": {
    "Enabled": true,
    "TimeoutSeconds": 3,
    "MaxRadiusKm": 50,
    "MaxRecipients": 500,
    "MaxParallelSends": 8,
    "MaxTitleLength": 60
  },
  "Observability": {
    "Metrics": {
      "Enabled": false,
      "Namespace": "Sensus/Api"
    }
  },
  "RateLimiting": {
    "AuthStrict": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Recover": { "PermitLimit": 3, "WindowSeconds": 3600 },
    "ReadHeavy": { "PermitLimit": 120, "WindowSeconds": 60 },
    "SensitiveWrite": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Favorites": { "PermitLimit": 120, "WindowSeconds": 3600 },
    "AiChat": { "PermitLimit": 10, "WindowSeconds": 60 },
    "PostLikes": { "PermitLimit": 60, "WindowSeconds": 3600 }
  },
  "OfferCategory": {
    "RequireStrictValidation": false
  },
  "Interactions": {
    "Enabled": true,
    "ImpressionSampleRate": 1.0,
    "RetentionDays": 180,
    "WriteTimeoutMs": 200,
    "RankingVersion": "feed-v1",
    "ActiveKeyVersion": 1,
    "CollectionLimitBytes": 157286400,
    "ClusterLimitBytes": 536870912,
    "AlarmThresholdPercent": 70,
    "EmitDetailedCustomMetrics": false
  },
  "FeedRanking": {
    "Version": "feed-v1",
    "Weights": {
      "Interest": 0.40,
      "Affinity": 0.25,
      "Proximity": 0.20,
      "Urgency": 0.10,
      "Popularity": 0.05
    },
    "MaxConsecutiveSameCategory": 3,
    "ExplorationEvery": 5,
    "NewOfferHours": 48,
    "SnapshotTtlMinutes": 10,
    "AffinityCacheMinutes": 10,
    "DefaultRadiusKm": 10,
    "MaxRadiusKm": 50,
    "MaxSnapshotOffers": 500
  },
  "OfferSearch": {
    "Version": "search-v1",
    "DefaultRadiusKm": 10,
    "MaxRadiusKm": 50,
    "GuestMaxRadiusKm": 2,
    "MaxCandidates": 200,
    "Weights": {
      "Text": 0.45,
      "CategoryMatch": 0.25,
      "Proximity": 0.20,
      "Popularity": 0.10
    }
  },
  "OfferAlternatives": {
    "DefaultLimit": 5,
    "MaxLimit": 10,
    "RegisteredMaxDistanceMeters": 10000,
    "GuestMaxDistanceMeters": 2000,
    "ComparablePriceRatio": 1.20
  },
  "ContentReports": {
    "AutoReviewThreshold": 3,
    "DeduplicationWindowHours": 24
  },
  "Offers": {
    "MaxActivePerMerchant": 20
  },
  "Mfa": {
    "EncryptionKey": "",
    "Issuer": "Sensus",
    "StepUpWindowMinutes": 15,
    "ChallengeExpiryMinutes": 5,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  }
}
